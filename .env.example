NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
CLIENT_URLS=https://waytoloans.com
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
COOKIE_SECURE=true
BOSS_NAME=Today Technologies Admin
BOSS_EMAIL=boss@example.com
BOSS_PASSWORD=replace-with-a-strong-password
BOSS_PANEL_PATH=boss-secret-panel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@waytoloans.com
